---
import InteriorLayout from "../layouts/InteriorLayout.astro";
import ContactForm from "../components/forms/ContactForm.astro";
import { FORMSPREE, ORG } from "../lib/config";
---

<InteriorLayout
  title="Contact"
  description="Get in touch with the Endangered Habitats League."
  eyebrow="Contact"
  heading="Contact us"
  intro="The Endangered Habitats League works throughout Southern California. If you need information or assistance, send us a message below."
>
  <div class="px-5 pb-16 tablet:px-14">
    <ContactForm endpoint={FORMSPREE.contact} />
    <p class="mt-8 text-[14px] text-text-secondary">
      {ORG.addressLine}, {ORG.city}, {ORG.state} &middot; {ORG.phone}
    </p>
  </div>
</InteriorLayout>
