---
import InteriorLayout from "../layouts/InteriorLayout.astro";
import NewsletterModal from "../components/forms/NewsletterModal.astro";
import Button from "../components/ui/Button.astro";
import { FORMSPREE, NEWSLETTER, DONATE_URL } from "../lib/config";
import heroImg from "../assets/images/rainbow.webp";

const benefits = [
  "Our electronic quarterly Newsletter, with updates on key conservation issues, reports on our work, and information on the fascinating plants and animals of our area.",
  "At your request only, occasional action alerts notifying you of important matters and opportunities to participate and, through your action, make a difference.",
  "No more than two emails a year asking for optional financial contributions — never more, and never shared outside EHL.",
];
---

<InteriorLayout
  title="Get Involved"
  description="Give and stay connected with the Endangered Habitats League's work protecting Southern California."
  eyebrow="Get Involved"
  heading="You are invited"
  intro="To reach out and expand our conservation community, we want to share our work and engage a wide range of people in our campaign to save the natural world around us. Signing up means you support our mission and the credible, collaborative work we do to achieve it."
  heroImage={heroImg}
>
  <div class="px-5 pb-16 tablet:px-14">
    <h2 class="text-h3 text-text-primary">In return, you'll receive</h2>
    <ul class="mt-4 flex max-w-[560px] flex-col gap-3">
      {
        benefits.map((benefit) => (
          <li class="flex gap-3 text-[14px] leading-[1.6] text-text-secondary tablet:text-[15px]">
            <span class="text-poppy" aria-hidden="true">
              —
            </span>
            <span>{benefit}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 max-w-[520px] text-[14px] leading-[1.6] text-text-secondary">
      Our network is secure and we pledge never to share your name, email
      address, or other information outside of EHL. Let's work together to
      hand down our beautiful natural world to our children.
    </p>

    <div class="mt-5">
      <NewsletterModal endpoint={FORMSPREE.joinUs} idPrefix="getinvolved-newsletter" />
    </div>
    <p class="mt-6 text-[14px] text-text-secondary">
      Read the{" "}
      <a
        class="text-link border-b border-border pb-0.5 text-deep-green"
        href={NEWSLETTER.current}
      >
        current newsletter
      </a>{" "}
      or browse the{" "}
      <a
        class="text-link border-b border-border pb-0.5 text-deep-green"
        href={NEWSLETTER.archive}
      >
        archive
      </a>.
    </p>

    <h2 id="support" class="text-h3 mt-10 text-text-primary">Support our work</h2>
    <div class="mt-4 flex max-w-[560px] flex-col gap-4">
      <p class="text-[14px] leading-[1.6] text-text-secondary tablet:text-[15px]">
        Your tax-deductible donation is a significant contribution toward the
        preservation of the magnificent natural landscapes of Southern
        California.
      </p>
      <p class="text-[14px] leading-[1.6] text-text-secondary tablet:text-[15px]">
        We need your support — it's that simple. Funding is needed for
        salaries, biological consultants, legal services, and the basic
        costs of doing business — everything from travel and phone bills to
        insurance. Fundraising expenses are less than one percent of our
        budget.
      </p>
      <p class="text-[14px] leading-[1.6] text-text-secondary tablet:text-[15px]">
        Your donations can help. No amount is too small. Your gifts
        contribute to the preservation of wildlife habitat, the curbing of
        urban sprawl, and the development and implementation of
        environmentally friendly land use policies.
      </p>
      <p class="text-[14px] leading-[1.6] text-text-secondary tablet:text-[15px]">
        Your donations are processed through a secure network, including the
        option to make your donations anonymously, or to do so in honor of
        another. If you would like to join with our like-minded supporters
        when making a donation, you will be given the option of providing
        your contact information to receive EHL's newsletters and action
        notices. In any event, EHL will not give your name or information to
        anyone else, ever.
      </p>
      <p class="text-[14px] leading-[1.6] text-text-secondary tablet:text-[15px]">
        We thank you for your interest and consideration, and look forward
        to sharing in this vital work with you.
      </p>
    </div>
    <Button href={DONATE_URL} external class="mt-5">Donate</Button>


  </div>
</InteriorLayout>
