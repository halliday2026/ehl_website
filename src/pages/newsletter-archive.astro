---

<InteriorLayout
  title="Newsletter Archive"
  description="Browse past issues of the Endangered Habitats League newsletter, from Summer 1998 to today."
  eyebrow="Get Involved"
  heading="Newsletter Archive"
  heroImage={heroImg}
  intro="The Endangered Habitats League has been publishing a quarterly newsletter for many years. For your reference, we've posted electronic copies of the newsletter issues from Summer of 1998 through present day."
>
  <div class="px-5 pb-16 tablet:px-14">
    <ul class="flex max-w-[640px] flex-col gap-2.5">
      {
        issues.map((issue) => (
          <li>
            <a
              href={issue.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-link inline-block border-b border-border pb-0.5 text-[14px] text-deep-green tablet:text-[15px]"
            >
              {issue.text}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 max-w-[520px] text-[14px] leading-[1.6] text-text-secondary">
      As of January 2004, EHL newsletters are distributed via email.
    </p>
    <a
      href={withBase("/get-involved/#newsletter")}
      class="text-link mt-2 inline-block border-b border-border pb-0.5 text-[14px] font-semibold text-deep-green"
    >
      Sign up for EHL's newsletter
    </a>
  </div>
</InteriorLayout>
