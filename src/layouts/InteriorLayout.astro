---
import BaseLayout from "./BaseLayout.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  noindex?: boolean;
}

const { title, description, eyebrow, heading, intro, noindex = false } =
  Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <div class="px-5 pt-12 pb-10 tablet:px-14 tablet:pt-[88px] tablet:pb-8">
    <Eyebrow class="mb-3">{eyebrow}</Eyebrow>
    <h1 class="text-h1 max-w-[820px] text-text-primary">{heading}</h1>
    <p class="text-lede mt-5 max-w-[680px] text-text-secondary">{intro}</p>
  </div>
  <slot />
</BaseLayout>
