---
import Eyebrow from "../ui/Eyebrow.astro";
import DuotoneImage from "../ui/DuotoneImage.astro";
import TextLink from "../ui/TextLink.astro";
import { withBase } from "../../lib/url";
import fieldImg from "../../assets/images/dbs-sbkr-a.webp";
---

<section class="bg-paper px-5 pb-11 tablet:px-14 tablet:pb-24">
  <div
    data-reveal
    class="flex flex-col gap-6 tablet:grid tablet:grid-cols-[1.1fr_.9fr] tablet:items-center tablet:gap-[52px]"
  >
    <DuotoneImage
      src={fieldImg}
      alt="A native kangaroo rat in its sandy desert habitat"
      duotoneOpacity={0.18}
      caption="Santa Ana River, San Bernardino County"
      class="h-[220px] tablet:h-[420px]"
    />
    <div>
      <Eyebrow>From the field</Eyebrow>
      <h2 class="text-h2 mt-2 text-text-primary [text-wrap:balance] tablet:mt-3.5">
        Room to Jump: Saving the San Bernardino Kangaroo Rat
      </h2>
      <p class="mt-2.5 text-[14px] leading-[1.6] text-text-secondary tablet:mt-4 tablet:text-base tablet:leading-[1.65]">
        The San Bernardino kangaroo rat is on the verge of extinction. Learn
        about how EHL is working to save it.
      </p>
      <TextLink href={withBase("/san-bernardino-kangaroo-rat/")} tone="on-paper" class="mt-3.5 tablet:mt-5">
        Read the story →
      </TextLink>
    </div>
  </div>
</section>
