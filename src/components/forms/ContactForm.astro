---
import Button from "../ui/Button.astro";

interface Props {
  endpoint: string;
}

const { endpoint } = Astro.props;
---

<form
  data-formspree-form
  data-endpoint={endpoint}
  data-success-message="Thanks for reaching out — we'll be in touch soon."
  novalidate
  class="flex max-w-[560px] flex-col gap-5"
>
  <div>
    <label for="contact-name" class="mb-1 block font-body text-sm font-semibold text-text-primary">
      Name
    </label>
    <input
      id="contact-name"
      name="name"
      type="text"
      required
      aria-describedby="contact-name-error"
      class="w-full rounded-btn border border-border bg-paper px-[18px] py-4 font-body text-[15px] text-text-primary"
    />
    <p id="contact-name-error" data-field-error aria-live="polite" class="mt-1 text-[13px] text-poppy"></p>
  </div>

  <div>
    <label for="contact-email" class="mb-1 block font-body text-sm font-semibold text-text-primary">
      Email
    </label>
    <input
      id="contact-email"
      name="email"
      type="email"
      required
      aria-describedby="contact-email-error"
      class="w-full rounded-btn border border-border bg-paper px-[18px] py-4 font-body text-[15px] text-text-primary"
    />
    <p id="contact-email-error" data-field-error aria-live="polite" class="mt-1 text-[13px] text-poppy"></p>
  </div>

  <div>
    <label for="contact-message" class="mb-1 block font-body text-sm font-semibold text-text-primary">
      Message
    </label>
    <textarea
      id="contact-message"
      name="message"
      required
      rows="5"
      aria-describedby="contact-message-error"
      class="w-full rounded-btn border border-border bg-paper px-[18px] py-4 font-body text-[15px] text-text-primary"
    ></textarea>
    <p id="contact-message-error" data-field-error aria-live="polite" class="mt-1 text-[13px] text-poppy"></p>
  </div>

  <div class="flex items-center gap-4">
    <Button type="submit" variant="dark" size="md">Send message</Button>
    <p data-form-status role="status" aria-live="polite" class="text-[13px] text-deep-green"></p>
  </div>
</form>

<script src="../../scripts/forms.ts"></script>
