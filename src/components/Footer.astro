---
import Button from "./ui/Button.astro";
import { FOOTER_NAV } from "../lib/nav";
import { SITE, ORG, DONATE_URL } from "../lib/config";
import { withBase } from "../lib/url";
---

<footer class="bg-footer-green px-5 pt-10 pb-10 text-[rgba(244,239,228,.78)] tablet:px-14 tablet:pt-[62px] tablet:pb-10">
  <div class="flex flex-wrap justify-between gap-10 border-b border-divider-dark pb-8 tablet:gap-12 tablet:pb-11">
    <div class="max-w-[300px]">
      <a href={withBase("/")} class="font-display text-[17px] font-semibold text-paper tablet:text-xl">
        {SITE.name}
      </a>
      <p class="mt-3.5 hidden text-sm leading-relaxed tablet:block">
        Protecting the diverse ecosystems of Southern California since {ORG.foundedYear}.
      </p>
      <div class="mt-5 hidden tablet:block">
        <Button href={DONATE_URL} external size="md">Donate</Button>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-8 font-body text-sm leading-loose tablet:grid-cols-4 tablet:gap-10">
      {
        FOOTER_NAV.map((column) => (
          <div>
            <div class="mb-1.5 font-semibold text-paper">{column.heading}</div>
            {column.links.map((link) => (
              <a
                href={link.external ? link.href : withBase(link.href)}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
                class="text-link block py-0.5 no-underline"
              >
                {link.label}
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div class="text-legal mt-6 flex flex-wrap justify-between gap-3 font-body text-[rgba(244,239,228,.55)]">
    <span>{ORG.addressLine}, {ORG.city}, {ORG.state} {ORG.zip}</span>
    <span>&copy; 2026 {SITE.name} &middot; A 501(c)(3) nonprofit organization</span>
  </div>
</footer>
