---
import Button from "../ui/Button.astro";
import { PRIMARY_NAV } from "../../lib/nav";
import { DONATE_URL } from "../../lib/config";
import { withBase } from "../../lib/url";
---

<div
  id="mobile-nav-panel"
  data-mobile-nav-panel
  hidden
  class="fixed inset-0 z-30 flex flex-col overflow-y-auto bg-deep-green px-6 py-6 tablet:hidden"
>
  <div class="flex items-center justify-between">
    <span class="font-display text-lg font-semibold text-paper">Menu</span>
    <button
      type="button"
      data-mobile-nav-close
      class="flex h-11 w-11 items-center justify-center text-paper"
    >
      <span class="sr-only">Close menu</span>
      <span aria-hidden="true" class="text-2xl leading-none">&times;</span>
    </button>
  </div>
  <nav aria-label="Mobile" class="mt-10 flex flex-col gap-1">
    {
      PRIMARY_NAV.map((link) => (
        <div class="border-b border-divider-dark">
          <a
            href={withBase(link.href)}
            class="text-link flex min-h-[44px] items-center py-3 font-body text-lg text-paper"
          >
            {link.label}
          </a>
          {link.children && (
            <div class="flex flex-col gap-1 pb-3 pl-4">
              {link.children.map((child) => (
                <a
                  href={child.external ? child.href : withBase(child.href)}
                  target={child.external ? "_blank" : undefined}
                  rel={child.external ? "noopener noreferrer" : undefined}
                  class="text-link flex min-h-[40px] items-center font-body text-base text-[rgba(251,248,241,.85)]"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))
    }
  </nav>
  <div class="mt-8">
    <Button href={DONATE_URL} external block size="lg">Donate</Button>
  </div>
</div>

<script src="../../scripts/mobile-nav.ts"></script>
